# Copy to .env and uncomment what you want to change; `docker compose up -d --wait` picks it up.
# The values shown are the defaults baked into compose.yaml.

# Tokens per sequence. 1048576 (1M) works: compose.yaml raises max_position_embeddings to match.
#CONTEXT=262144
# Concurrent sequences.
#MAX_SEQS=8
# Share of the 121.6 GiB unified memory vLLM claims (weights 73.4 GiB + KV + activations). 0.75 leaves a
# 1.39M-token KV pool and ~30 GiB for the OS. 0.80 tipped the box into swap with anything else running.
#GPU_UTIL=0.75
# Chunked-prefill size.
#BATCHED_TOKENS=8192
# fp8 is what Aleph Alpha evaluated with.
#KV_DTYPE=fp8
# Server-wide reasoning default: none | low | medium | high. Unset = the chat template's default (high).
# Once set, clients switch it per request with reasoning_effort; enable_thinking alone no longer overrides it.
#REASONING_EFFORT=medium

#SERVED_NAME=Kolibri-1
#HOST=0.0.0.0
#PORT=8888

# aleph-alpha-inference 1.x supports exactly one vLLM minor (0.29): change both together, then
# `docker compose build`.
#VLLM_VERSION=0.29.0
#AA_INFERENCE_VERSION=1.0.0
#MODEL_ID=Aleph-Alpha/Kolibri-1
#MODEL_REVISION=e52eb4627d11516b0c01de49210ab5a4e4061444

#HF_CACHE=~/.cache/huggingface
#KERNEL_CACHE=~/.cache/kolibri-1-dgx-spark
# Only needed if the model ever becomes gated.
#HF_TOKEN=
